"""``pyshark.packet.layers.base`` as of pyshark 0.6: the base class of every layer."""
from typing import Any

class BaseLayer:
    def __init__(self, layer_name: str) -> None: ...
    @property
    def layer_name(self) -> str: ...
    @property
    def field_names(self) -> list[str]: ...
    # a field by name, or ``AttributeError`` when the layer has no such field
    def __getattr__(self, item: str) -> Any: ...
